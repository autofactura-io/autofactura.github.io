{
	"site": {
		"app": "Autofactura"
	},
	"server": {
		"request": "${xover.session.server}/request.asp",
		"login": "POST ${xover.session.server}/login.asp",
		"logout": "${xover.session.server}/logout.asp",
		"facturar": {
			"POST server:request": {
				"FROM": "autofactura.actualizarTicketsXFacturar",
				"^x-payload-parameter-name": "@xml"
			}
		}
	},
	"session": {
		"server": "https://server.autofactura.io"
	},
	"sources": {
		"^#([^?]+)(\\?.*)?": {
			"server:request": {
				"FROM": "PanaxBI.$1"
			}
		},
		"#": "#shell",
		"#shell": "portal-shell.xml?v=20261126_7",
		"#login": "login.xml",
		"#loading": true,
		"#settings": "settings.xml",
		"px-daterange": "widgets/daterange.xhtml?v=20261126_7",
		"px-combobox": "widgets/combobox.xhtml",
		"px-printer": "widgets/printer.xhtml",
		"px-refresh": "widgets/refresh_button.xhtml?v=20261126_7",
		"px-to-excel": "widgets/excel_button.xhtml",
		"px-loader": "widgets/loader.xhtml",
		"google-chart": "widgets/google-chart.xhtml",
		"#menu": "menus.xml",
		"#globalization": [ "assets/globalization/headerText.${xo.session.locale.split('-').shift()}.resx", "assets/globalization/headerText.resx" ],
		"#sitemap": "autofactura-sitemap.xml?v=20261126_7",
		"/widgets/page_navbar.xslt": "/page_navbar.xslt?v=20261127_4",
		"/widgets/page_controls.xslt": "/reportes/portal_page_controls.xslt?v=20261126_10",
		"/widgets/sitemap.xslt": "/sitemap.xslt",
		"#factura_global": "factura_global.xml?v=20261126_7",
		"#factura_cliente": "factura_cliente.xml?v=20261126_7",
		"#consulta_facturas": "consulta_facturas.xml?v=20261126_7",
		"#ventas": "ventas-mensuales.xml?v=20261127_6",
		"autofactura-filters": "autofactura/components/autofactura-filters.xhtml?v=20261126_7",
		"#impuestos": "impuestos_scoped.html",
		"#concentrador": "concentrador_scoped.html?v=20261126_7",
		"#prefactura": "prefactura.xml",
		"#resumen_descarga_cfdi": {
			"server:request": { "FROM": "[DescargaMasiva].[reporteDescargaCFDI]" }
		},
		"excel-selection": "widgets/excel-selection.xhtml",
		"value-filter": "widgets/value-filter.xhtml",
		"#facturas": {
			"server:request": {
				"FROM": "autofactura.portalTickets",
				"^X-PAGE-SIZE": "50",
				"^X-PAGE-INDEX": "1",
				"@xml": "<query periodo=\"actual\" order_by=\"[@tkt]\" />"
			}
		},
		"#tax_rules": {
			"server:request": {
				"FROM": "autofactura.product_tax_rules",
				"^X-ORDER-BY": "product_description"
			}
		},
		"#ws": {
			"xover.socket.connect": [
				"ws://localhost:8003",
				{
					"message": "#messages",
					"hotreload": "event:hotreload",
					"databaseChange": "event:databaseChange"
				}
			]
		}
	},
	"start": [
		"loading.xslt",
		"px-combobox",
		"px-daterange",
		"px-printer",
		"px-refresh",
		"autofactura-filters",
		"px-to-excel",
		"px-loader",
		{ "updateTunnel": [] }

	],
	"settings": {
		"^#.*": {
			"headers": {
				"Cache-Control": "max-age=0",
				"x-debugging": "true",
				"expiry": 1
			}
		},
		"#factura_global": { "target": "@#shell main", "cache": "no-store" },
		"#ventas": { "target": "@#shell main", "cache": "no-store" },
		"#factura_cliente": { "target": "@#shell main", "cache": "no-store" },
		"#consulta_facturas": { "target": "@#shell main", "cache": "no-store" },
		"~/reportes/portal_operacion_reportes.xslt": { "cache": "reload" },
		"~/reportes/portal_ventas_hojas_conciliadas.xslt": { "cache": "reload" },
		"~/factura_global.xslt": { "cache": "reload" },
		"#impuestos": { "target": "@#shell main" },
		"#concentrador": { "target": "@#shell main" },
		"#prefactura": { "target": "@#shell main" },
		"#resumen_descarga_cfdi": {
			"cache": "no-store",
			"headers": { "Accept": "application/xml, text/xml" },
			"stylesheets": [{ "href": "reportes/resumen_descarga_cfdi.xslt", "target": "@#shell main" }],
			"expiry": 1
		},
		"#server:login": { "resumable": false, "rejectCodes": 400, "authentication": false, "cache": "no-store" },
		"#server:logout": { "resumable": false, "authentication": false, "cache": "no-store", "headers": { "Accept": "application/json" } },
		"#facturas": {
			"cache": "no-store",
			"headers": { "Accept": "application/xml, text/xml" }
		},
		"#tax_rules": {
			"headers": {
				"x-root-node": "model",
				"x-row-node": "row",
				"x-xml-mode": "PATH",
				"x-page-size": "10000"
			}
		},
		"~.asp": {
			"headers": {
				"x-connection-id": "autofactura",
				"x-referer-id": "${xover.session.referer_id}",
				"authorization": "${xover.session.id_token}"
			}
		},
		"#server:request": {
			"authentication": "#login"
		},
		"#login": { "cache": "no-store" },
		"#shell": {
			"cache": "no-store",
			"hash": ""
		}
	}
}
